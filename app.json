{
  "expo": {
    "name": "app_bolsa",
    "slug": "app_bolsa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo_v.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo_v.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.dfdez.app_bolsa"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "ec9cef43-298d-4b6e-91e5-7f4298971a02"
      }
    }
  }
}
